@model UpdateTestimonialDto
@{
    ViewData["Title"] = "UpdateTestimonial";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">Referans İşlemleri</h4>
		<div class="row">
			<div class="col-md-12">
				<form method="post">
					<div class="card">
						<div class="card-header">
							<div class="card-title">Yeni Giriş</div>
						</div>
						<input type="hidden" asp-for="TestimonialID" />
						<div class="card-body">
							<div class="form-group">
								<label for="ClientName">Müşteri Adını Giriniz </label>
								<input type="text" class="form-control" asp-for=ClientName id="ClientName">
							</div>
						</div>
						<div class="card-body">
							<div class="form-group">
								<label for="Title">Müşteri Ünvanını Giriniz </label>
								<input type="text" class="form-control" asp-for=Title id="Title">
							</div>
						</div>
						<div class="card-body">
							<div class="form-group">
								<label for="ClientComment">Müşteri Yorumu Giriniz </label>
								<input type="text" class="form-control" asp-for=ClientComment id="ClientComment">
							</div>
						</div>
						<div class="card-body">
							<div class="form-group">
								<label for="ClientImageUrl">Dosya - Resim Yolu Giriniz </label>
								<input type="text" class="form-control" asp-for=ClientImageUrl id="ClientImageUrl">
							</div>
						</div>
						<div class="card-action">
							<button class="btn btn-primary">Güncelle</button>
						</div>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>

