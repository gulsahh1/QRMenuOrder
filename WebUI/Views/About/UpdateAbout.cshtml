@model UpdateAboutDto
@{
    ViewData["Title"] = "UpdateAbout";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">Anasayfa Hakkımızda İşlemleri</h4>
		<div class="row">
			<div class="col-md-12">
				<form method="post">
					<div class="card">
						<div class="card-header">
							<div class="card-title">Güncelleme Sayfası</div>
						</div>
						<input  type="hidden" asp-for="AboutID" />
						<div class="card-body">
							<div class="form-group">
								<label for="abouttitle">Başlık Giriniz </label>
								<input type="text" class="form-control" asp-for=Title id="abouttitle">
							</div>
						</div>
						<div class="card-body">
							<div class="form-group">
								<label for="abouttitle">Görselin URL'ini Giriniz' </label>
								<input type="text" class="form-control" asp-for=ImageUrl id="abouttitle">
							</div>
						</div>
						<div class="card-body">
							<div class="form-group">
								<label for="Description">Açıklama Giriniz </label>
								<textarea rows="5" class="form-control" asp-for="Description" id="Description"></textarea>
							</div>
						</div>
						<div class="card-action">
							<button class="btn btn-primary">Güncelle</button>
						</div>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>

