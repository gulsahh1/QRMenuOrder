@model UpdateSocialMediaDto
@{
    ViewData["Title"] = "UpdateSocialMedia";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">Sosyal Medya İşlemleri</h4>
		<div class="row">
			<div class="col-md-12">
				<form method="post">
					<div class="card">
						<div class="card-header">
							<div class="card-title">Yeni Girişi</div>
						</div>
						<input type="hidden" asp-for="SocialMediaID" />
						<div class="card-body">
							<div class="form-group">
								<label for="Name">Sosyal Medya Adını Giriniz </label>
								<input type="text" class="form-control" asp-for=Name id="Name">
							</div>
						</div>
						<div class="card-body">
							<div class="form-group">
								<label for="Url">URL Giriniz </label>
								<input type="text" class="form-control" asp-for=Url id="Url">
							</div>
						</div>
						<div class="card-body">
							<div class="form-group">
								<label for="icon">İcon Giriniz </label>
								<input type="text" class="form-control" asp-for=Icon id="icon">
							</div>
						</div>
						<div class="card-action">
							<button class="btn btn-primary">Güncelle</button>
						</div>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>

